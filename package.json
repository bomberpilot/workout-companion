{
  "name": "workout-companion",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "zip": "powershell -Command \"Compress-Archive -Path . -DestinationPath code_$((Get-Date).ToString('yyyyMMdd_HHmm')).zip -CompressionLevel NoCompression -Exclude node_modules,.git,.expo,dist,build\"",
    "typecheck": "tsc --noEmit",
    "typecheck:functions": "npm --prefix functions run typecheck",
    "lint": "expo lint",
    "doctor": "expo-doctor",
    "test": "npm run test:app && npm --prefix functions test && npm run test:firestore",
    "build:check": "expo export --platform ios --platform android",
    "check": "npm run typecheck && npm run typecheck:functions && npm run lint && npm run doctor && npm test && npm run build:check",
    "test:app": "node --test tests/firebase-auth.test.cjs",
    "test:firestore": "npm --prefix functions run build && firebase emulators:exec --only firestore --project demo-workout-companion \"node --test --test-concurrency=1 tests/firestore-rules.test.cjs tests/group-lifecycle-emulator.test.cjs\"",
    "dependencies:report": "node scripts/dependency-report.cjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-navigation/elements": "^2.9.3",
    "@react-navigation/native": "^7.1.26",
    "@react-navigation/native-stack": "^7.9.0",
    "expo": "~54.0.37",
    "expo-application": "~7.0.8",
    "expo-device": "~8.0.10",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.12",
    "expo-localization": "~17.0.9",
    "expo-notifications": "~0.32.17",
    "expo-status-bar": "~3.0.9",
    "firebase": "^12.7.0",
    "posthog-react-native": "^4.17.2",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-calendars": "^1.1314.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/react": "~19.1.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-preset-expo": "~54.0.10",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~10.0.0",
    "expo-doctor": "^1.20.4",
    "firebase-tools": "^15.33.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
